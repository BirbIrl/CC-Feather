{
  [ "feather.featherd.units" ] = {
    mirrord = {
      command = "mirrord",
      onDeath = "keep",
    },
    comfortd = {
      useShell = true,
      onDeath = "remove",
      command = "runner comfortd",
    },
  },
  [ "list.show_hidden" ] = true,
  [ "shell.allow_disk_startup" ] = false,
  [ "feather.bundle.mirrorID" ] = 2,
  [ "motd.enable" ] = false,
}
